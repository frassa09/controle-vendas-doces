# Copie para .env (na raiz) e preencha. O .env nunca vai para o git.

# Projeto Supabase de PRODUÇÃO (usado pelo app; o integrador aplica as migrações)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Projeto Supabase de TESTES (testes do core e npm run db:push:test)
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_PROJECT_REF=
SUPABASE_TEST_DB_PASSWORD=

# Token pessoal da CLI do Supabase (Dashboard > Account > Access Tokens)
SUPABASE_ACCESS_TOKEN=

# Endereço da página do cliente (Vercel), usado no link das mensagens de cobrança
CUSTOMER_PAGE_URL=
